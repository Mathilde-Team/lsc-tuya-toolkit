#!/bin/sh

PTZCTL="/tmp/sd/custom/bin/ptzctl"

if [ ! -x "${PTZCTL}" ]; then
    exit 1
fi

# Les clients ONVIF (Home Assistant) envoient une vitesse tres faible (0.1) :
# le driver moteur ne reagit pas en dessous d'un seuil. On force 0.8 pour
# les mouvements directionnels.
if [ "$1" = "-m" ]; then
    case "$2" in
        up|down|left|right)
            exec "${PTZCTL}" -m "$2" -s 0.8
            ;;
    esac
fi

# Preset : ptzctl -p ne fait que memoriser la position, sans bouger le moteur.
# On convertit la position enregistree (pas 0..360 / 0..196) en absolu normalise.
if [ "$1" = "-p" ]; then
    DB="/tmp/sd/custom/state/ptz_presets.db"
    TRIPLE="$(LC_ALL=C awk -F, -v id="$2" '$1==id {printf "%.4f,%.4f,0", $3/180-1, $4/98-1; exit}' "${DB}" 2>/dev/null)"
    [ -n "${TRIPLE}" ] || exit 1
    exec "${PTZCTL}" -j "${TRIPLE}"
fi

exec "${PTZCTL}" "$@"
