diff --git a/ptz_service.c b/ptz_service.c
index 5c93184..7fcac9d 100644
--- a/ptz_service.c
+++ b/ptz_service.c
@@ -806,12 +806,14 @@ int ptz_absolute_move()
 
     } else {
         if ((x != NULL) && (y != NULL)) {
+            /* Espace absolu normalise [-1,1] (PositionGenericSpace) : c'est ce
+             * qu'envoient Home Assistant et les clients ONVIF courants. */
             dx = atof(x);
-            if ((dx > service_ctx.ptz_node.max_step_x) || (dx < service_ctx.ptz_node.min_step_x)) {
+            if ((dx > 1.0) || (dx < -1.0)) {
                 ret = -5;
             }
             dy = atof(y);
-            if ((dy > service_ctx.ptz_node.max_step_y) || (dy < service_ctx.ptz_node.min_step_y)) {
+            if ((dy > 1.0) || (dy < -1.0)) {
                 ret = -6;
             }
             if (z != NULL) {
@@ -952,6 +954,11 @@ int ptz_get_status()
     }
 
     if (ret == 0) {
+        /* get_position renvoie des pas (0..max_step) : conversion en [-1,1] */
+        if (service_ctx.ptz_node.max_step_x > 0)
+            x = x / (service_ctx.ptz_node.max_step_x / 2.0) - 1.0;
+        if (service_ctx.ptz_node.max_step_y > 0)
+            y = y / (service_ctx.ptz_node.max_step_y / 2.0) - 1.0;
         snprintf(sx, sizeof(sx), "%f", x);
         snprintf(sy, sizeof(sy), "%f", y);
         snprintf(sz, sizeof(sz), "%f", z);
